{
  "name": "cline-desktop-zh-cn",
  "private": true,
  "version": "0.1.2",
  "description": "Cline Desktop 简体中文运行时汉化补丁。",
  "license": "Apache-2.0",
  "author": "Exschwi",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExSchwi/cline-desktop-zh-cn.git"
  },
  "homepage": "https://github.com/ExSchwi/cline-desktop-zh-cn#readme",
  "bugs": {
    "url": "https://github.com/ExSchwi/cline-desktop-zh-cn/issues"
  },
  "scripts": {
    "generate-dictionary": "bun tools/generate-dictionary.ts",
    "launch": "node src/launcher.mjs",
    "build:windows": "bun tools/build-windows.mjs",
    "check": "node --check src/launcher.mjs && node --check src/injector.mjs && node --check src/resources.mjs && node --check tools/self-check.mjs && node --check tools/shortcut.mjs && node --check tools/build-windows.mjs && node --check tools/generate-icon.mjs",
    "self-check": "node tools/self-check.mjs",
    "install-shortcut": "node tools/shortcut.mjs install",
    "uninstall-shortcut": "node tools/shortcut.mjs uninstall",
    "dev:audit-compatibility": "node tools/dev/audit-compatibility.mjs",
    "dev:audit-bundle-compatibility": "node tools/dev/audit-bundle-compatibility.mjs"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  }
}
